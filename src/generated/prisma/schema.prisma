// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id @default(cuid())
  auth0Sub              String           @unique @map("auth0_sub")
  email                 String?          @unique
  name                  String?
  picture               String?
  subscriptionPlan      SubscriptionPlan @default(free) @map("subscription_plan")
  subscriptionStartDate DateTime?        @map("subscription_start_date")
  subscriptionEndDate   DateTime?        @map("subscription_end_date")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  // Relations
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("SentNotifications")
  holidays          Holiday[]

  @@map("users")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  title       String
  message     String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  holidayId   String?  @map("holiday_id")
  fromUserId  String?  @map("from_user_id")
  isRead      Boolean  @default(false) @map("is_read")
  isDismissed Boolean  @default(false) @map("is_dismissed")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user     User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User?    @relation("SentNotifications", fields: [fromUserId], references: [id], onDelete: SetNull)
  holiday  Holiday? @relation(fields: [holidayId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([isDismissed])
  @@index([createdAt])
  @@map("notifications")
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  holidayType String   @map("holiday_type")
  date        DateTime
  description String?  @db.Text
  userId      String   @map("user_id")
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([date])
  @@index([holidayType])
  @@map("holidays")
}

enum SubscriptionPlan {
  free
  plus
}
